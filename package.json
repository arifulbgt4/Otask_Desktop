{
  "name": "otask",
  "version": "0.1.0",
  "private": true,
  "description": "GUI-first local task orchestration and cross-device control platform",
  "license": "MIT",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.14.0 <25"
  },
  "scripts": {
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "build": "pnpm -r --if-present build",
    "contracts:check": "pnpm --filter @otask/contracts check",
    "auth:check": "node scripts/check-auth-config.mjs && pnpm --filter @otask/auth check",
    "device:check": "node scripts/check-device-functions.mjs",
    "grant:check": "node scripts/check-grant-functions.mjs",
    "terminal:check": "node scripts/check-terminal-functions.mjs",
    "release:check": "node scripts/check-release-functions.mjs"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.5.6"
  }
}
