{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otask.dev/schemas/run-grant.schema.json",
  "title": "OTask short-lived scoped run or terminal grant",
  "type": "object",
  "required": [
    "schema_version",
    "grant_id",
    "grant_type",
    "user_id",
    "device_id",
    "run_id",
    "plan_hash",
    "scope",
    "issued_at",
    "expires_at",
    "nonce",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "grant_id": {
      "type": "string",
      "pattern": "^grant_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"
    },
    "grant_type": { "enum": ["run", "terminal"] },
    "user_id": {
      "type": "string",
      "pattern": "^user_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"
    },
    "device_id": {
      "type": "string",
      "pattern": "^device_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"
    },
    "plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scope": {
      "type": "object",
      "required": ["workspace_refs", "step_ids", "read_only"],
      "properties": {
        "workspace_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "string",
            "pattern": "^workspace_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$"
          }
        },
        "step_ids": {
          "type": "array",
          "maxItems": 30,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{0,47}$" }
        },
        "read_only": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "issued_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "expires_at": { "$ref": "common.schema.json#/$defs/timestamp" },
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43,256}$" }
  },
  "additionalProperties": false
}
