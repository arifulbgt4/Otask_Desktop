{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otask.dev/schemas/error-envelope.schema.json",
  "title": "OTask error envelope",
  "type": "object",
  "required": ["ok", "error", "request_id", "occurred_at"],
  "properties": {
    "ok": { "const": false },
    "error": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 500 },
        "retryable": { "type": "boolean" },
        "details": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "request_id": { "$ref": "common.schema.json#/$defs/otaskId" },
    "occurred_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
